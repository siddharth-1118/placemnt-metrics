# ---- Database ----
# Local development (zero-config SQLite). Switch to Supabase/Postgres in production:
# DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# ---- Scraping engine ----
# "auto" (default): try live GitHub/HackerRank scraping, fall back to deterministic mock data on failure.
# "live": only live scraping (errors surface instead of mock data).
# "mock": fully offline demo mode - no network calls at all.
SCRAPE_MODE="auto"

# Optional: GitHub personal access token (raises the REST rate limit from 60 to 5000 req/h).
# Create one at https://github.com/settings/tokens (no scopes needed for public data).
# GITHUB_TOKEN=""

# ---- Auth ----
# Required in production: HMAC key that signs session cookies. Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---- Document storage ----
# "supabase": store uploads in Supabase Storage (serverless-ready; needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
# "disk": store under uploads/ (local dev only — lost on Vercel)
# "auto": supabase when keys are present, else disk
STORAGE_DRIVER="auto"
